# (2) ورد الرجز في " التهذيب " و " اللسان " في درج الكلام المنثور، وقد
~~تحول إلى نثر، وصارت " النحامة " " نحاما ".

# (3) عجز ثاني بيتين وردا في " اللسان " (لفف) غير منسوبين وهما: إذا ما
